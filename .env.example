# Copy this file to `.env` and adjust for your environment.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets (API keys, passwords, tokens) in these variables.

# Public site URL (used for canonical URLs / Open Graph). No trailing slash.
VITE_SITE_URL=https://usksoftwaresolutions.com

# Contact form delivery mode:
#   mock   -> simulates a successful submission (default, no backend needed)
#   mailto -> opens the visitor's email app with the enquiry pre-filled
#   api    -> POSTs JSON to VITE_API_BASE_URL + VITE_CONTACT_ENDPOINT
VITE_CONTACT_MODE=mock

# Backend REST API base URL (only used when VITE_CONTACT_MODE=api), e.g. Spring Boot
VITE_API_BASE_URL=
VITE_CONTACT_ENDPOINT=/api/v1/enquiries
